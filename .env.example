# ============================================================
# /api/chat 后端接口所需环境变量（OpenAI 兼容协议）
# 本文件是模板；实际使用时请复制为 .env 并填入真实值。
# .env 已被 .gitignore 忽略，切勿提交到仓库。
# ============================================================

# 模型服务地址（OpenAI 兼容接口）
# - OpenAI 官方：      https://api.openai.com/v1
# - DeepSeek：         https://api.deepseek.com/v1
# - Moonshot Kimi：    https://api.moonshot.cn/v1
# - 通义千问兼容模式： https://dashscope.aliyuncs.com/compatible-mode/v1
# - 自建 OneAPI 网关： https://your-oneapi.example.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型 API Key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 模型名称（要在你上面配置的服务里真实存在）
# 示例：gpt-4o-mini / gpt-4o / deepseek-chat / qwen-plus / moonshot-v1-8k
OPENAI_MODEL=gpt-4o-mini